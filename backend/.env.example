# Database Configuration
DATABASE_URL=sqlite:///./sql_app.db
ENV=development
PROJECT_NAME=Resume Role Match Analyzer

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","https://resume-analyzer-swart-two.vercel.app"]

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection (choose one)
# Free and Powerful (default): nvidia/nemotron-3-ultra-550b-a55b:free
# Most capable: openai/gpt-4-turbo-preview
# Fast and cost-effective: openai/gpt-4-mini
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenRouter API Endpoint (standard)
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
